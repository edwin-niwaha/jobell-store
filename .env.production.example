# Set these in Railway Variables for BOTH the web and worker services.
# Never commit real credentials. This example is intentionally incomplete.
DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=core.settings.production
DEBUG=False
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECRET_KEY=
BASE_DOMAIN=jobellinc.com
SITE_URL=https://jobellinc.com
SITE_NAME=Jobell Store
ALLOWED_HOSTS=jobellinc.com,www.jobellinc.com
CSRF_TRUSTED_ORIGINS=https://jobellinc.com,https://www.jobellinc.com
CORS_ALLOWED_ORIGINS=https://jobellinc.com
TIME_ZONE=Africa/Kampala

# Use Railway references: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Railway private PostgreSQL networking may require False; use True for TLS endpoints.
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=60

# Set all three below to ${{Redis.REDIS_URL}}. Both services must use the same broker.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
ORDER_EMAIL_USE_CELERY=True

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=Jobell Store <noreply@jobellinc.com>
RESEND_FROM_EMAIL=Jobell Store <noreply@jobellinc.com>
ADMIN_ORDER_EMAILS=jobellinc@gmail.com
SUPPORT_EMAIL=jobellinc@gmail.com

# Optional online payments. Leave ALL empty when using manual Mobile Money / COD.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# Optional browser Google login (register /oauth/complete/google-oauth2/ with Google).
GOOGLE_KEY=
GOOGLE_SECRET=
GITHUB_KEY=
GITHUB_SECRET=

# Optional Firebase authentication for the mobile client.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
LOG_LEVEL=INFO
LOG_TO_FILE=False
WEB_CONCURRENCY=2
WEB_THREADS=2
